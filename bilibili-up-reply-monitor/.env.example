# 要监控的视频（短链 / 完整链接 / BV 号均可）
VIDEO_URL=https://b23.tv/KGXJu1o

# 轮询间隔（秒），建议 30–60，过快可能触发风控
POLL_INTERVAL=45

# 已见评论存储
DB_PATH=data/seen.sqlite3

# ---- 主推送通道：通用 Webhook（飞书 / 钉钉 / 自定义）----
# 自定义机器人 Webhook 完整 URL
WEBHOOK_URL=

# 载荷风格：
#   custom   — 发送结构化 JSON（text/title/video/reply），适合自建服务
#   feishu   — 飞书/Lark 自定义机器人 text 消息
#   lark     — 同 feishu
#   dingtalk — 钉钉自定义机器人 text 消息
WEBHOOK_STYLE=feishu

# ---- 可选：Telegram ----
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ---- 可选：B 站 Cookie（遇到 HTTP 412 或 code -352 时再填）----
# 从浏览器登录 bilibili.com 后复制，例如：
# BILIBILI_COOKIE=buvid3=xxx; SESSDATA=xxx; bili_jct=xxx
# BILIBILI_COOKIE=
